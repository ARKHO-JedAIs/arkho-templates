# Core app
ENV_NAME=dev
PROJECT_NAME={{ project_name }}
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Sign in with Microsoft and/or Google: comma-separated microsoft, google.
# Empty = email and password only. A listed provider is created once its
# values below are set; README "Sign in with Microsoft or Google".
SSO_PROVIDERS={{ sso_providers }}
# Microsoft Entra ID. Issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_ISSUER_URL=
# Google (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend URLs Cognito may return to after sign-in / sign-out (comma-separated).
AUTH_CALLBACK_URLS=http://localhost:5173/auth/callback
AUTH_LOGOUT_URLS=http://localhost:5173/login

# Second sign-in step: a code emailed after the password (Cognito email MFA).
# SES_FROM_EMAIL must be a verified SES identity in AWS_REGION, and the SES
# account out of the sandbox to email users who are not verified themselves.
EMAIL_MFA_ENABLED={{ login_otp }}
SES_FROM_EMAIL=

# WhatsApp (End User Messaging Social). Written into a Parameter Store
# parameter at deploy time, which the Lambdas read; it can also be edited there.
# The phone number ARN carries the account id: keep real values in .env only.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_PHONE_PREFIX={{ default_phone_prefix }}
WHATSAPP_AUTO_REPLY_MESSAGE=""
WHATSAPP_META_API_VERSION=v20.0

# Who may use the WhatsApp API and realtime channel: members of
# WHATSAPP_ADMIN_GROUP, or any signed-in user when WHATSAPP_REQUIRE_ADMIN=false.
WHATSAPP_ADMIN_GROUP={{ admin_group }}
WHATSAPP_REQUIRE_ADMIN={{ use_roles }}

# WhatsApp media bucket: days to keep received/sent files (empty = forever)
# and how long a presigned file URL works, in seconds.
MEDIA_RETENTION_DAYS=
MEDIA_URL_TTL_SECONDS=900

# User management API (/admin/users) behind the frontend's Usuarios screen.
USERS_API_ENABLED={{ include_users_admin }}
