# Generated by arkho-cli from your answers - local values.
# Gitignored, never committed. The committed placeholder is .env.example.

# Core app
ENV_NAME=dev
PROJECT_NAME={{ project_name }}
AWS_ACCOUNT_ID={{ aws_account_id }}
AWS_REGION={{ aws_region }}

# Microsoft Entra ID SSO (optional, OIDC federation)
ENTRA_ID_ENABLED=false
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# Second sign-in step: a code emailed after the password (Cognito email MFA)
EMAIL_MFA_ENABLED={{ login_otp }}
SES_FROM_EMAIL={{ ses_from_email }}
