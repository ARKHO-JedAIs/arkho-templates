# Copy to .env and fill in the values for your environment:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Only this file is versioned,
# and only with placeholders. A secretlint pre-commit hook blocks credentials.

# Core app
# ENV_NAME: deployment environment. Drives the resource-name suffix
# (${PROJECT_NAME}-${ENV_NAME}-<resource>) and isProd (prod enables DynamoDB
# point-in-time recovery, deletion protection, and log retention on destroy).
# One of: dev | staging | prod. Required.
ENV_NAME=dev
# PROJECT_NAME: prefix of every AWS resource name. Pre-filled with the project
# name you gave the generator; keep it lowercase with no underscores (it also
# feeds the S3 bucket name and the Cognito Hosted UI domain prefix). Required.
PROJECT_NAME={{ project_name }}
# Deployment target. AWS_ACCOUNT_ID is left empty on purpose: an empty value
# makes the stack account-agnostic, so `cdk synth` and `npm test` work with no
# AWS setup. Set it (12 digits) before `cdk bootstrap` / `cdk deploy` - find it
# with: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Microsoft Entra ID SSO (optional, OIDC federation)
# Off by default. Set ENTRA_ID_ENABLED=true to federate the Cognito User Pool to
# Entra ID; that also provisions a Hosted UI domain whose prefix is derived in
# code as ${PROJECT_NAME}-${ENV_NAME} (not an env var).
# The three values below are required ONLY when ENTRA_ID_ENABLED=true, and synth
# fails fast with a clear message if any is missing.
# ENTRA_ID_CLIENT_SECRET is a real secret: keep it out of git (move it to AWS
# Secrets Manager before production use).
ENTRA_ID_ENABLED=false
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=
ENTRA_ID_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
