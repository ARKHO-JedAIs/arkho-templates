{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "dist"
    ]
  },
  "context": {
    "projectName": "{{ project_name }}",
    "environment": "{{ environment }}",
    "adminEmail": "{{ admin_email }}",
    "bucketPrefix": "{{ bucket_prefix }}",
    "rawRetentionDays": "{{ raw_retention_days }}",
    "archiveRetentionYears": "{{ archive_retention_years }}",
    "enableGlueDataCatalog": "{{ enable_glue_catalog }}",
    "enableAthena": "{{ enable_athena }}",
    "enableLakeFormation": "{{ enable_lake_formation }}",
    "enableVpc": "{{ enable_vpc }}",
    "vpcCidr": "{{ vpc_cidr }}"
  }
}
