# Configuración del ambiente `dev`.
#
# ESTE ARCHIVO SE VERSIONA. No es un `.env` de secretos: acá van retenciones,
# horarios, umbrales y tamaños, que el equipo necesita ver y revisar en un PR.
# Las credenciales van a Secrets Manager (ver el secreto `<proyecto>-dev/source-db`)
# o a `.env.local`, que sí está gitignoreado.
#
# El ambiente existe porque este archivo existe: `lib/config/environments.ts`
# descubre los ambientes leyendo `config/*.env`. Para agregar `qa`, copia este
# archivo a `config/qa.env` y ajústalo. Para quitar un ambiente, borra su archivo.
#
# Todas las claves son OBLIGATORIAS y se validan al sintetizar: un número mal
# escrito, un booleano que no sea true/false o una clave desconocida cortan el
# `synth` con un mensaje que dice archivo, clave y qué se esperaba.

# Cuenta AWS destino (12 dígitos). VACÍO = usar la cuenta por defecto de la
# generación; es la señal de diseño con la que funciona la estrategia de cuenta
# compartida. Ver DEFAULT_ACCOUNT en lib/config/environments.ts.
ACCOUNT={{ aws_account_id_dev }}
REGION={{ aws_region }}

# RETAIN | DESTROY. DESTROY + AUTO_DELETE_OBJECTS=true es la única combinación
# donde `cdk destroy` se lleva los datos. CDK rechaza AUTO_DELETE_OBJECTS=true
# junto a RETAIN, así que los dos van de la mano.
REMOVAL_POLICY=DESTROY
AUTO_DELETE_OBJECTS=true
TERMINATION_PROTECTION=false

# Días antes de transicionar la Raw Zone a Glacier Instant Retrieval (0 = nunca,
# los datos quedan en S3 Standard).
RAW_TRANSITION_DAYS={{ raw_retention_days }}
# Años de retención en la Archive Zone antes de expirar (0 = indefinida).
ARCHIVE_RETENTION_YEARS={{ archive_retention_years }}

# Crons de EventBridge, SIEMPRE en UTC. El crawler debe partir DESPUÉS de que el
# pipeline termine: un crawler a mitad de escritura infiere el esquema de datos
# parciales. Si tus jobs Glue se acercan al timeout de 60 min, aleja el crawler.
PIPELINE_SCHEDULE={{ pipeline_schedule }}
CRAWLER_SCHEDULE={{ crawler_schedule }}

# Máximo de workers Glue (con auto-scaling escala hacia abajo solo).
GLUE_MAX_WORKERS=3
# Corte de bytes escaneados por query en Athena, en GiB. Control de costos.
ATHENA_BYTES_CUTOFF_GIB=5

ALERT_EMAIL={{ admin_email }}
# Días de retención de los log groups que crea este proyecto. Se redondea hacia
# arriba al valor que CloudWatch acepta.
LOG_RETENTION_DAYS=30

# Días que los registros rechazados quedan en la Quarantine Zone.
QUARANTINE_RETENTION_DAYS=30
# Filas rechazadas por corrida a partir de las cuales el pipeline se detiene y se
# dispara la alarma. Es un valor ABSOLUTO, no un porcentaje: en un día de 10
# millones de filas 100 rechazos no lo cortan, y en uno de 10 mil sí. Ajústalo al
# volumen real de tus fuentes.
QUARANTINE_ALARM_THRESHOLD=100

# Ventana de time-travel de Iceberg: los snapshots más viejos se expiran en el
# job de mantenimiento semanal.
ICEBERG_SNAPSHOT_RETENTION_DAYS=7
