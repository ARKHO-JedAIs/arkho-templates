{
  "name": "{{ project_slug }}-cdk",
  "version": "0.1.0",
  "description": "IaC del Data Lake Fundacional AWS para {{ client_name }} (CDK v2, TypeScript)",
  "bin": {
    "{{ project_slug }}": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval broadening",
    "nag": "cdk synth --quiet -c nag=true",
    "synth:all": "node scripts/each-env.js synth --quiet",
    "diff:all": "node scripts/each-env.js diff",
    "nag:all": "node scripts/each-env.js synth --quiet -c nag=true"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.9",
    "aws-cdk": "^2.170.0",
    "cdk-nag": "^2.34.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
