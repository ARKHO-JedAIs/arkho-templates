# Generated by arkho-cli from your answers - local dev values.
# Gitignored, never committed. The committed placeholder is .env.example.
#
# Every VITE_ variable is inlined into the client bundle and is readable by
# anyone using the app. Public configuration only - never a secret or an AWS key.

# --- Authentication ---
VITE_AUTH_PROVIDER={{ auth_provider }}
VITE_MOCK_AUTH_GROUPS={{ admin_group }}
VITE_COGNITO_USER_POOL_ID={{ cognito_user_pool_id }}
VITE_COGNITO_USER_POOL_CLIENT_ID={{ cognito_user_pool_client_id }}
VITE_ADMIN_GROUP={{ admin_group }}

# --- Backend API ---
VITE_API_BASE_URL={{ api_base_url }}
VITE_USERS_API_PATH=/admin/users

# --- Chat ---
VITE_AGENT_CHAT_API_URL={{ agent_chat_api_url }}
VITE_CHAT_CAPABILITIES={{ chat_capabilities }}
VITE_CHAT_VOICE_LANGUAGE=es-US
VITE_COGNITO_IDENTITY_POOL_ID={{ cognito_identity_pool_id }}
VITE_CHAT_IMAGES_UPLOAD_URL={{ chat_images_upload_url }}
