# =============================================================================
# Environment
#
# Copy to .env and fill in. Everything here is a VITE_ variable, which means it
# is INLINED INTO THE CLIENT BUNDLE and readable by anyone using the app.
# Never put a secret, an API key or an AWS access key in this file.
#
# This is the committed placeholder for teammates: it carries example shapes,
# never real values. The generator wrote your actual answers into .env, which is
# gitignored. Keep the two in sync key-for-key.
# =============================================================================

# --- Authentication -----------------------------------------------------------
# `mock`    - no backend at all. Any credentials are accepted, the session lives
#             in localStorage. Lets the app run before a user pool exists.
# `cognito` - a real Cognito user pool. Requires the two ids below.
VITE_AUTH_PROVIDER=mock

# Only read when VITE_AUTH_PROVIDER=mock. Comma-separated Cognito-style groups
# the fake user belongs to. Must include VITE_ADMIN_GROUP for admin screens to
# be reachable in mock mode.
VITE_MOCK_AUTH_GROUPS=admin

# Required when VITE_AUTH_PROVIDER=cognito. Missing values are reported as a
# configuration screen at startup rather than a runtime exception.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# The Cognito group that unlocks admin-only screens.
VITE_ADMIN_GROUP=admin

# --- Backend API --------------------------------------------------------------
# Base URL of your API. Leave empty to run the UI without a backend: screens
# that need data will surface their own error states.
VITE_API_BASE_URL=

# Path of the user-management endpoints, appended to VITE_API_BASE_URL.
# Expected: GET / POST /, PATCH|DELETE /{username}, PATCH /{username}/status,
# POST /{username}/password
VITE_USERS_API_PATH=/admin/users

# --- Chat ---------------------------------------------------------------------
# Base URL of the agent chat backend. The client POSTs to {url}/chat and reads
# a text/event-stream response. See README "Chat backend contract".
VITE_AGENT_CHAT_API_URL=

# Which chat capabilities are on, as a comma-separated list. Valid entries:
#   voice  - push-to-talk dictation via Amazon Transcribe streaming
#   images - attachments uploaded straight to S3 with a presigned PUT URL
# Both are runtime flags on purpose: turn one on later, once the matching
# backend endpoint exists, without regenerating the project.
VITE_CHAT_CAPABILITIES=

# Voice only. Transcribe is a real AWS call, so it needs an identity pool AND
# VITE_AUTH_PROVIDER=cognito - it cannot work under mock auth.
VITE_CHAT_VOICE_LANGUAGE=es-US
VITE_COGNITO_IDENTITY_POOL_ID=

# Images only. Endpoint that hands out presigned S3 PUT targets.
VITE_CHAT_IMAGES_UPLOAD_URL=
